{
    "name": "JoeyDev Studio",
    "image": "mcr.microsoft.com/devcontainers/php:1-8.3",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        }
    },
    "containerEnv": {
        "XDEBUG_MODE": "off"
    },
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "JoeyDev Studio",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh"
}
